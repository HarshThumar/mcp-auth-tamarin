theory MCP_Code_And_Audience
begin

builtins: hashing

// Codes and access tokens are tagged so that Tamarin never confuses them
// with PKCE verifiers or other fresh values. The tags carry a public
// destructor (uncd / unat): the attacker can unwrap and rebuild them, so a
// tag hides nothing, and every rule variable stays derivable (no
// wellformedness warnings).
functions: cd/1, at/1, uncd/1, unat/1
equations: uncd(cd(x)) = x, unat(at(x)) = x

/*
 * Model 02: does an authorization code / access token only reach the
 * authorization server (AS) and MCP server (RS) it was meant for?
 *
 * Spec pinned: MCP authorization, draft as of 11 Nov 2026
 *   https://modelcontextprotocol.io/specification/draft/basic/authorization
 *   - PKCE (S256) on every authorization request          (OAuth 2.1, RFC 7636)
 *   - `resource` in authorization AND token requests       (RFC 8707)
 *   - client records the expected issuer and checks `iss`  (RFC 9207 §2.4)
 *       AS "SHOULD" send `iss`. If AS metadata does not advertise
 *       `authorization_response_iss_parameter_supported` and `iss` is absent,
 *       the client "proceeds".
 *   - the MCP server MUST check the token audience          (RFC 8707 §2)
 *
 * Properties (docs/flow.md)
 *   P2 rs_accepts_only_consented: an honest MCP server only accepts a token
 *      for user U if U consented to a token for THAT server.
 *   P3 token_secrecy: an access token issued by an honest AS to an honest
 *      client for an honest MCP server never reaches the attacker (covers
 *      mix-up).
 *   P6 session_integrity: if an honest user's client session with an honest
 *      AS ends with a token, that token was issued by that AS for that user
 *      and that client (no code injection / login CSRF).
 *
 * Variants (Tamarin preprocessor flags; scripts/prove.sh runs all six)
 *   -D=NO_AUD        the MCP server does not check the token audience.
 *                    Ground truth: GHSA-w4fh-qvv9-3v23 (Python SDK,
 *                    CVE-2026-116684) and GHSA-rvq5-wwqv-78pq (TypeScript SDK,
 *                    CVE-2026-111771): "a valid token for another service was
 *                    also accepted by your MCP server".
 *                    expected: P2 FALSIFIED, P3 verified
 *   -D=NO_ISS        the client ignores `iss` (no RFC 9207 check).
 *                    Ground truth: the AS mix-up attack (RFC 9700 §4.4,
 *                    RFC 9207 §1). PKCE alone does not stop it.
 *                    expected: P2 verified, P3 FALSIFIED
 *   -D=ISS_OPTIONAL  everything as the draft says today: honest ASes MAY omit
 *                    `iss` (it is a SHOULD) and the client then proceeds when
 *                    the recorded metadata does not advertise `iss` support.
 *                    expected: P2 verified, P3 FALSIFIED
 *   -D=NO_RESOURCE   the AS ignores RFC 8707 `resource` and mints the token
 *                    with a broad audience: some honest MCP server ($AnyRS),
 *                    not necessarily the requested one (Spec gap G4).
 *                    expected: P2 FALSIFIED, P3 verified
 *   -D=NO_STATE      the client does not generate a unique state per session;
 *                    uses a fixed public constant ('no_state') (Spec gap G7).
 *                    expected: all verified (PKCE alone keeps P6)
 *   -D=NO_PKCE       the AS does not check the PKCE verifier.
 *                    expected: all verified (state alone keeps P6)
 *   -D=NO_PKCE -D=NO_STATE
 *                    expected: P6 FALSIFIED (code injection / login CSRF)
 *   -D=NO_REDIRECT_CHECK
 *                    the AS does not match `redirect_uri` against the client's
 *                    registered URIs (CIMD document): an attacker-built
 *                    request with the attacker's redirect URI and its own
 *                    PKCE challenge, approved by an honest user, sends the
 *                    code to the attacker (RFC 9700 §4.1).
 *                    expected: P3 FALSIFIED (PKCE does not help: the
 *                    attacker chose the challenge)
 *   (no flag)        honest ASes always send `iss`, the client always checks
 *                    it, the MCP server checks the audience.
 *                    expected: P2 verified, P3 verified
 *
 * Abstraction (see docs/threat-model.md)
 *   - Dolev-Yao network. An honest user's browser reaches the AS over HTTPS
 *     (private fact Browser): `state` and the PKCE challenge of an honest
 *     user's session are not visible to the network, but an attacker-run AS
 *     receives (leaks) every request sent to it. The attacker can also send
 *     any authorization request to an honest AS (a victim's browser it
 *     redirects; some honest user approves) and any callback to the client's
 *     redirect URI (CSRF).
 *   - TLS to a named endpoint = private linear fact (ToAS / FromAS / ToRS /
 *     ToClient). A dishonest endpoint leaks what it receives.
 *   - Each AS and each MCP server is set up exactly once, as honest or as
 *     dishonest (attacker-run). Honest MCP servers name an honest AS in their
 *     protected resource metadata. A dishonest MCP server names any AS.
 *   - Every honest MCP server accepts tokens from every honest AS
 *     (worst case: one shared AS, as in the advisories above).
 *   - Users: each client session belongs to one user. Attacker-controlled
 *     users ($Ua, User_Dishonest) get real codes for their own accounts,
 *     delivered to the attacker's browser, for any client.
 *   - Clients: honest public clients, plus attacker-run clients ($E) that
 *     obtain real codes and tokens (for users who consent to them) at
 *     honest ASes. P3 is stated for honest clients only.
 *   - Codes are single-use: the code record is consumed at the token
 *     endpoint (lemma code_single_use).
 *   - Left out: refresh tokens, scopes/step-up, DPoP, expiry, browser
 *     internals (cookies, redirects, origins).
 */

/* ------------------------------------------------------------------ */
/* Setup                                                              */
/* ------------------------------------------------------------------ */

// Honest AS that always sends `iss` and advertises it in its metadata.
rule Setup_Honest_AS_Iss:
    [ ]
  --[ ASSetup($AS), AS_Honest($AS) ]->
    [ !HonestAS($AS), !ASMeta($AS, 'true') ]

#ifdef ISS_OPTIONAL
// Honest AS that follows the "SHOULD" literally: it does not send `iss`
// and does not advertise it.
rule Setup_Honest_AS_NoIss:
    [ ]
  --[ ASSetup($AS), AS_Honest($AS) ]->
    [ !HonestAS($AS), !ASMeta($AS, 'false') ]
#endif

// Attacker-run AS. The attacker chooses what its metadata advertises.
rule Setup_Dishonest_AS_Iss:
    [ ]
  --[ ASSetup($X), AS_Dishonest($X) ]->
    [ !DishonestAS($X), !ASMeta($X, 'true') ]

rule Setup_Dishonest_AS_NoIss:
    [ ]
  --[ ASSetup($X), AS_Dishonest($X) ]->
    [ !DishonestAS($X), !ASMeta($X, 'false') ]

// Honest MCP server; its protected resource metadata names an honest AS.
rule Setup_Honest_RS:
    [ !HonestAS($AS) ]
  --[ RSSetup($RS), RS_Honest($RS) ]->
    [ !HonestRS($RS), !PRM($RS, $AS) ]

// Attacker-run (malicious) MCP server.
rule Setup_Dishonest_RS:
    [ ]
  --[ RSSetup($X), RS_Dishonest($X) ]->
    [ !DishonestRS($X) ]

// Honest client (public client, CIMD-style).
rule Setup_Honest_Client:
    [ ]
  --[ ClientSetup($C), Client_Honest($C) ]->
    [ !HonestClient($C) ]

// Attacker-run client: its redirect URI is the attacker's.
rule Setup_Dishonest_Client:
    [ ]
  --[ ClientSetup($E), Client_Dishonest($E) ]->
    [ !DishonestClient($E) ]

// The attacker controls some user accounts.
rule Setup_Dishonest_User:
    [ ]
  --[ User_Dishonest($Ua) ]->
    [ !DishonestUser($Ua) ]

#ifdef NO_PKCE
#else
// The token endpoint checks the PKCE verifier against the stored challenge.
restriction pkce_checked:
  "All x y #t. PkceCheck(x, y) @ #t ==> x = y"
#endif

restriction client_set_up_once:
  "All x #i #j. ClientSetup(x) @ #i & ClientSetup(x) @ #j ==> #i = #j"

restriction as_set_up_once:
  "All x #i #j. ASSetup(x) @ #i & ASSetup(x) @ #j ==> #i = #j"

restriction rs_set_up_once:
  "All x #i #j. RSSetup(x) @ #i & RSSetup(x) @ #j ==> #i = #j"

/* ------------------------------------------------------------------ */
/* Client: discovery + authorization request (PKCE, resource, state)  */
/* ------------------------------------------------------------------ */

#ifdef NO_STATE
// NO_STATE (G7): the client does not generate a unique random state per
// session; it uses the public constant 'no_state'.
#define FIXED_STATE
#endif

// Client (session of user $U) connects to an honest MCP server and reads its
// authentic PRM. The authorization request goes through $U's browser.
#ifdef FIXED_STATE
rule Client_Start_Honest_RS:
    [ !HonestClient($C), !PRM($RS, $AS), !ASMeta($AS, issSupported)
    , Fr(~sid), Fr(~ver) ]
  --[ ClientStart(~sid, $C, $U, $RS, $AS) ]->
    [ St_Client_1(~sid, $C, $U, $RS, $AS, issSupported, ~ver, 'no_state')
    , Browser($AS, $U, <'authz_request', $AS, $C, h(~ver), $RS, 'no_state'>) ]

rule Client_Start_Dishonest_RS:
    [ !HonestClient($C), !DishonestRS($RS), In(<'prm', $RS, $AS>)
    , !ASMeta($AS, issSupported), Fr(~sid), Fr(~ver) ]
  --[ ClientStart(~sid, $C, $U, $RS, $AS) ]->
    [ St_Client_1(~sid, $C, $U, $RS, $AS, issSupported, ~ver, 'no_state')
    , Browser($AS, $U, <'authz_request', $AS, $C, h(~ver), $RS, 'no_state'>) ]
#else
rule Client_Start_Honest_RS:
    [ !HonestClient($C), !PRM($RS, $AS), !ASMeta($AS, issSupported)
    , Fr(~sid), Fr(~ver), Fr(~state) ]
  --[ ClientStart(~sid, $C, $U, $RS, $AS) ]->
    [ St_Client_1(~sid, $C, $U, $RS, $AS, issSupported, ~ver, ~state)
    , Browser($AS, $U, <'authz_request', $AS, $C, h(~ver), $RS, ~state>) ]

// Client connects to a malicious MCP server, which names any AS it likes.
rule Client_Start_Dishonest_RS:
    [ !HonestClient($C), !DishonestRS($RS), In(<'prm', $RS, $AS>)
    , !ASMeta($AS, issSupported), Fr(~sid), Fr(~ver), Fr(~state) ]
  --[ ClientStart(~sid, $C, $U, $RS, $AS) ]->
    [ St_Client_1(~sid, $C, $U, $RS, $AS, issSupported, ~ver, ~state)
    , Browser($AS, $U, <'authz_request', $AS, $C, h(~ver), $RS, ~state>) ]
#endif

// An attacker-run AS sees the whole authorization request.
rule Dishonest_AS_Leaks_Authz:
    [ Browser($X, $U, m), !DishonestAS($X) ]
  --[ LeakedAuthz($X) ]->
    [ Out(m) ]

/* ------------------------------------------------------------------ */
/* Honest AS: authorization endpoint                                  */
/* ------------------------------------------------------------------ */

// Codes always record the requested resource; under NO_RESOURCE the token
// endpoint ignores it.

// The user's own request, from the client's session.
rule AS_Authorize_Iss:
    [ Browser($AS, $U, <'authz_request', $AS, $C, challenge, $RS, state>)
    , !HonestAS($AS), !ASMeta($AS, 'true'), !HonestClient($C), Fr(~code) ]
  --[ Consent($U, $C, $RS, $AS), CodeIssued(cd(~code)) ]->
    [ Code($AS, cd(~code), $U, $C, challenge, $RS)
    , ToClient($C, <'authz_response', cd(~code), state, $AS>) ]

rule AS_Authorize_NoIss:
    [ Browser($AS, $U, <'authz_request', $AS, $C, challenge, $RS, state>)
    , !HonestAS($AS), !ASMeta($AS, 'false'), !HonestClient($C), Fr(~code) ]
  --[ Consent($U, $C, $RS, $AS), CodeIssued(cd(~code)) ]->
    [ Code($AS, cd(~code), $U, $C, challenge, $RS)
    , ToClient($C, <'authz_response_noiss', cd(~code), state>) ]

// A request the attacker built (e.g. the victim's browser redirected by an
// attacker-run AS, as in mix-up): some honest user $U approves it.
rule AS_Authorize_Iss_Net:
    [ In(<'authz_request', $AS, $C, challenge, $RS, state>)
    , !HonestAS($AS), !ASMeta($AS, 'true'), !HonestClient($C), Fr(~code) ]
  --[ Consent($U, $C, $RS, $AS), CodeIssued(cd(~code)) ]->
    [ Code($AS, cd(~code), $U, $C, challenge, $RS)
    , ToClient($C, <'authz_response', cd(~code), state, $AS>) ]

rule AS_Authorize_NoIss_Net:
    [ In(<'authz_request', $AS, $C, challenge, $RS, state>)
    , !HonestAS($AS), !ASMeta($AS, 'false'), !HonestClient($C), Fr(~code) ]
  --[ Consent($U, $C, $RS, $AS), CodeIssued(cd(~code)) ]->
    [ Code($AS, cd(~code), $U, $C, challenge, $RS)
    , ToClient($C, <'authz_response_noiss', cd(~code), state>) ]

#ifdef NO_REDIRECT_CHECK
// NO_REDIRECT_CHECK: the AS accepts any redirect_uri for an honest client.
// The attacker sends an honest user a crafted authorization link with its
// own redirect URI (and its own PKCE challenge); the user approves, and the
// code goes to the attacker.
rule AS_Authorize_Open_Redirect:
    [ In(<'authz_request', $AS, $C, challenge, $RS, state, 'attacker_redirect_uri'>)
    , !HonestAS($AS), !HonestClient($C), Fr(~code) ]
  --[ Consent($U, $C, $RS, $AS), CodeIssued(cd(~code)) ]->
    [ Code($AS, cd(~code), $U, $C, challenge, $RS)
    , Out(<'authz_response', cd(~code), state, $AS>) ]
#endif

// An attacker-controlled user authorizes any client in the attacker's own
// browser: the code lands in the attacker's hands.
rule AS_Authorize_Dishonest_User:
    [ In(<'authz_request', $AS, $C, challenge, $RS, state, $Ua>)
    , !HonestAS($AS), !DishonestUser($Ua), Fr(~code) ]
  --[ Consent($Ua, $C, $RS, $AS), CodeIssued(cd(~code)) ]->
    [ Code($AS, cd(~code), $Ua, $C, challenge, $RS)
    , Out(<'authz_response', cd(~code), state, $AS>) ]

// Authorization for an attacker-run client: some user consents, and the code
// goes to the attacker's redirect URI (the network).
rule AS_Authorize_Dishonest_Client:
    [ In(<'authz_request', $AS, $E, challenge, $RS, state>)
    , !HonestAS($AS), !DishonestClient($E), Fr(~code) ]
  --[ Consent($U, $E, $RS, $AS), CodeIssued(cd(~code)) ]->
    [ Code($AS, cd(~code), $U, $E, challenge, $RS)
    , Out(<'authz_response', cd(~code), state, $AS>) ]

// The attacker can also send any callback to the client's redirect URI
// (e.g. what its own AS "returns", or a CSRF'd callback).
rule Attacker_Callback_Iss:
    [ In(<'authz_response', cd(code), state, $iss>) ]
  -->
    [ ToClient($C, <'authz_response', cd(code), state, $iss>) ]

rule Attacker_Callback_NoIss:
    [ In(<'authz_response_noiss', cd(code), state>) ]
  -->
    [ ToClient($C, <'authz_response_noiss', cd(code), state>) ]

/* ------------------------------------------------------------------ */
/* Client: callback, `iss` check (RFC 9207 §2.4), token request       */
/* ------------------------------------------------------------------ */

#ifdef NO_ISS

// NO_ISS: whatever `iss` says, the code goes to the AS this session started with.
rule Client_Callback_Iss:
    [ St_Client_1(~sid, $C, $U, $RS, $AS, issSupported, ~ver, state)
    , ToClient($C, <'authz_response', cd(code), state, $iss>) ]
  --[ ClientRedeems(~sid, $C, $AS, cd(code)) ]->
    [ St_Client_2(~sid, $C, $RS, $AS)
    , ToAS($AS, ~sid, <'token_request', $C, cd(code), ~ver, $RS>) ]

#else

// `iss` present: compare with the recorded issuer (rows 1 and 3 of the table).
rule Client_Callback_Iss:
    [ St_Client_1(~sid, $C, $U, $RS, $AS, issSupported, ~ver, state)
    , ToClient($C, <'authz_response', cd(code), state, $AS>) ]
  --[ ClientRedeems(~sid, $C, $AS, cd(code)) ]->
    [ St_Client_2(~sid, $C, $RS, $AS)
    , ToAS($AS, ~sid, <'token_request', $C, cd(code), ~ver, $RS>) ]

#endif

// `iss` absent: proceed only if the recorded metadata does not advertise
// `iss` support (row 4). Row 2 (advertised but absent) has no rule: reject.
rule Client_Callback_NoIss:
    [ St_Client_1(~sid, $C, $U, $RS, $AS, 'false', ~ver, state)
    , ToClient($C, <'authz_response_noiss', cd(code), state>) ]
  --[ ClientRedeems(~sid, $C, $AS, cd(code)) ]->
    [ St_Client_2(~sid, $C, $RS, $AS)
    , ToAS($AS, ~sid, <'token_request', $C, cd(code), ~ver, $RS>) ]

/* ------------------------------------------------------------------ */
/* Honest AS: token endpoint (PKCE + resource must match the code)    */
/* ------------------------------------------------------------------ */

#ifdef NO_RESOURCE

// NO_RESOURCE (G4): AS does not support RFC 8707 Resource Indicators; it ignores
// the requested $RS and issues a token valid for any honest RS ($AnyRS).
rule AS_Token:
    [ ToAS($AS, ~sid, <'token_request', $C, cd(~code), ~ver, $RS>)
    , !HonestAS($AS), !HonestRS($AnyRS)
    , Code($AS, cd(~code), $U, $C, chal, code_aud)
    , Fr(~tok) ]
  --[ PkceCheck(chal, h(~ver))
    , TokenIssued(at(~tok), $AS, $U, $C, $RS), CodeUsed(cd(~code)) ]->
    [ !Token(at(~tok), $AS, $U, $AnyRS)
    , FromAS(~sid, <'token_response', at(~tok)>) ]

rule AS_Token_From_Network:
    [ In(<'token_request', $C, cd(~code), ver, $RS>)
    , !HonestAS($AS), !HonestRS($AnyRS)
    , Code($AS, cd(~code), $U, $C, chal, code_aud)
    , Fr(~tok) ]
  --[ PkceCheck(chal, h(ver))
    , TokenIssued(at(~tok), $AS, $U, $C, $RS), CodeUsed(cd(~code)) ]->
    [ !Token(at(~tok), $AS, $U, $AnyRS)
    , Out(at(~tok)) ]

#else

// Token request from an honest client, over its own TLS connection ~sid.
rule AS_Token:
    [ ToAS($AS, ~sid, <'token_request', $C, cd(~code), ~ver, $RS>)
    , !HonestAS($AS)
    , Code($AS, cd(~code), $U, $C, chal, $RS)
    , Fr(~tok) ]
  --[ PkceCheck(chal, h(~ver))
    , TokenIssued(at(~tok), $AS, $U, $C, $RS), CodeUsed(cd(~code)) ]->
    [ !Token(at(~tok), $AS, $U, $RS)
    , FromAS(~sid, <'token_response', at(~tok)>) ]

// The same endpoint used by the attacker as an ordinary public client:
// the request comes from the network and the token goes back to it.
rule AS_Token_From_Network:
    [ In(<'token_request', $C, cd(~code), ver, $RS>)
    , !HonestAS($AS)
    , Code($AS, cd(~code), $U, $C, chal, $RS)
    , Fr(~tok) ]
  --[ PkceCheck(chal, h(ver))
    , TokenIssued(at(~tok), $AS, $U, $C, $RS), CodeUsed(cd(~code)) ]->
    [ !Token(at(~tok), $AS, $U, $RS)
    , Out(at(~tok)) ]

#endif

// An attacker-run AS leaks every request and can answer on that connection.
rule Dishonest_AS_Leaks:
    [ ToAS($X, ~sid, m), !DishonestAS($X) ]
  --[ LeakedToAS($X) ]->
    [ Out(<~sid, m>) ]

rule Dishonest_AS_Answers:
    [ In(<~cid, 'token_response', at(tok)>) ]
  -->
    [ FromAS(~cid, <'token_response', at(tok)>) ]

/* ------------------------------------------------------------------ */
/* Client uses the token; MCP server validates it                     */
/* ------------------------------------------------------------------ */

rule Client_Use_Token:
    [ St_Client_2(~sid, $C, $RS, $AS)
    , FromAS(~sid, <'token_response', at(tok)>) ]
  --[ ClientUsesToken(~sid, $C, $RS, at(tok)) ]->
    [ ToRS($RS, <'bearer', at(tok)>) ]

// The attacker can present any token it holds to any honest MCP server.
// (Sending to its own dishonest server teaches it nothing new.)
rule Attacker_To_RS:
    [ In(<'bearer', at(tok)>), !HonestRS($RS) ]
  -->
    [ ToRS($RS, <'bearer', at(tok)>) ]

#ifdef NO_AUD

// NO_AUD: the token is valid at an honest AS, but its audience is not checked.
rule RS_Accepts:
    [ ToRS($RS, <'bearer', at(~tok)>), !HonestRS($RS)
    , !Token(at(~tok), $AS, $U, aud) ]
  --[ RSAccepts($RS, $U, aud, at(~tok)) ]->
    [ ]

#else

// Audience must be this MCP server (RFC 8707 §2; MCP "Token Handling").
rule RS_Accepts:
    [ ToRS($RS, <'bearer', at(~tok)>), !HonestRS($RS)
    , !Token(at(~tok), $AS, $U, $RS) ]
  --[ RSAccepts($RS, $U, $RS, at(~tok)) ]->
    [ ]

#endif

rule Dishonest_RS_Leaks:
    [ ToRS($X, m), !DishonestRS($X) ]
  --[ LeakedToRS($X) ]->
    [ Out(m) ]

/* ------------------------------------------------------------------ */
/* Lemmas                                                             */
/* ------------------------------------------------------------------ */

// Sources lemmas (proved by induction). They tell Tamarin where a code or
// token in the client's hands can come from, which stops the loop
// "attacker injects x into the client -> client leaks x -> attacker knows x".
lemma code_sources [sources]:
  "All sid c as code #i.
     ClientRedeems(sid, c, as, code) @ #i
     ==> (Ex #j. CodeIssued(code) @ #j & #j < #i)
       | (Ex #j. KU(code) @ #j & #j < #i)"

lemma token_sources [sources]:
  "All sid c rs tok #i.
     ClientUsesToken(sid, c, rs, tok) @ #i
     ==> (Ex as u c2 aud #j. TokenIssued(tok, as, u, c2, aud) @ #j & #j < #i)
       | (Ex #j. KU(tok) @ #j & #j < #i)"

// Sanity: a fully honest run reaches an honest MCP server.
lemma executable:
  exists-trace
  "Ex rs u t #i. RSAccepts(rs, u, rs, t) @ #i
     & not (Ex x #j. AS_Dishonest(x) @ #j)
     & not (Ex x #j. RS_Dishonest(x) @ #j)"

// P2: an honest MCP server accepts a token for user U only if U consented
// to access for that very server.
lemma rs_accepts_only_consented:
  "All rs u aud t #i.
     RSAccepts(rs, u, aud, t) @ #i
     ==> Ex c as #j. Consent(u, c, rs, as) @ #j"

// P3: a token from an honest AS, issued for an honest user to an honest
// client for an honest MCP server, stays secret. (Tokens of attacker-run
// clients and of attacker-controlled users are known to the attacker by
// design: a public client has no secret, so the attacker can use its
// client_id for its own account.)
lemma token_secrecy:
  "All t as u c rs #i.
     TokenIssued(t, as, u, c, rs) @ #i
     & not (Ex #j. RS_Dishonest(rs) @ #j)
     & not (Ex #j. Client_Dishonest(c) @ #j)
     & not (Ex #j. User_Dishonest(u) @ #j)
     ==> not (Ex #k. K(t) @ #k)"

// P6: session integrity. If an honest user's client session with an honest
// AS ends with a token, the token was issued by that AS, for that user and
// that client. Fails under code injection / login CSRF.
lemma session_integrity:
  "All sid c u rs as t #s #i.
     ClientStart(sid, c, u, rs, as) @ #s
     & ClientUsesToken(sid, c, rs, t) @ #i
     & not (Ex #j. User_Dishonest(u) @ #j)
     & not (Ex #j. AS_Dishonest(as) @ #j)
     ==> Ex rs2 #j. TokenIssued(t, as, u, c, rs2) @ #j"

// Codes are single-use: an honest AS redeems each code at most once.
lemma code_single_use:
  "All c #i #j. CodeUsed(c) @ #i & CodeUsed(c) @ #j ==> #i = #j"

end
