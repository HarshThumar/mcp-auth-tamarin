theory MCP_AS_Selection
begin

/*
 * Model 01: which authorization server receives the client's credentials?
 *
 * Spec pinned: RFC 9728 and MCP authorization, draft as of 14 Nov 2026
 *   - Client Registration, "Authorization Server Binding": pre-registered and
 *     DCR credentials "MUST" be associated with the AS that issued them,
 *     keyed by the AS's `issuer` identifier.
 *   - The client "MUST record the issuer value from the selected
 *     authorization server's validated metadata document" (RFC 8414 §3.3:
 *     the metadata `issuer` must equal the issuer the client discovered).
 *
 * Context
 *   In MCP, the server a client connects to tells the client which
 *   authorization server (AS) to use, via its Protected Resource Metadata
 *   (RFC 9728). That MCP server may be malicious.
 *
 *   MCP Python SDK advisory GHSA-qx49-fqc8-xw99 (CVE-2026-115563,
 *   28 Sep 2026) describes the class of bug this model abstracts:
 *   "stored or pre-provisioned client credentials were not bound to the
 *   authorization server they belong to", so a malicious MCP server could
 *   name its own AS and receive credentials meant for the real one.
 *
 * Property
 *   P1 client_credential_secrecy: a credential registered at an honest AS
 *      never reaches the attacker.
 *
 * Variants (Tamarin preprocessor flags)
 *   -D=VULNERABLE          the client sends its stored credential to whatever
 *                          AS the MCP server names (no binding at all).
 *                          Ground truth: GHSA-qx49-fqc8-xw99.
 *                          expected: P1 FALSIFIED
 *   -D=UNVALIDATED_ISSUER  credentials are keyed by issuer, but the client
 *                          looks them up under the `issuer` the AS metadata
 *                          *claims*, without the RFC 8414 §3.3 check.
 *                          expected: P1 FALSIFIED (an attacker-run AS claims
 *                          the honest AS's issuer)
 *   (no flag)              keyed by issuer AND the metadata issuer is
 *                          validated against the AS the client contacts.
 *                          expected: P1 verified
 *
 * Abstraction (deliberately small; see docs/threat-model.md)
 *   - A client credential (client_secret, private_key_jwt key, ...) is one
 *     fresh secret, stored under the issuer of the AS it was registered at.
 *   - Dolev-Yao network; all metadata is attacker-controlled. An attacker-run
 *     AS publishes metadata with ANY `issuer` value. Honest AS metadata is
 *     correct (issuer = its own identifier).
 *   - Requests to an AS travel over TLS: private fact ToAS. A dishonest AS
 *     leaks what it receives.
 *   - The two client checks are restrictions on one action each
 *     (CredLookup, MetaIssuer), so each flag removes exactly one equality.
 *   - Model 03 (`RT_UNBOUND`, `NO_META_CHECK`) is the full version of this
 *     question, with codes, tokens and refresh tokens.
 */

rule Setup_Honest_AS:
    [ ]
  --[ ASSetup($A), AS_Honest($A) ]->
    [ !HonestAS($A), !ASMeta($A, $A) ]

// Attacker-run AS: its metadata may claim any issuer $I.
rule Setup_Dishonest_AS:
    [ ]
  --[ ASSetup($X), AS_Dishonest($X) ]->
    [ !DishonestAS($X), !ASMeta($X, $I) ]

restriction as_set_up_once:
  "All x #i #j. ASSetup(x) @ #i & ASSetup(x) @ #j ==> #i = #j"

// The client registers at an honest AS; the credential is stored under that
// AS's issuer.
rule Register_Client:
    [ !HonestAS($A), Fr(~cred) ]
  --[ Registered($C, $A, ~cred) ]->
    [ !ClientCred($C, $A, ~cred) ]

#ifdef VULNERABLE
#else
// Credentials are looked up under the issuer recorded for this AS.
restriction credential_bound_to_issuer:
  "All stored rec #t. CredLookup(stored, rec) @ #t ==> stored = rec"
#endif

#ifdef VULNERABLE | UNVALIDATED_ISSUER
#else
// RFC 8414 §3.3: the metadata issuer must be the AS the client contacts.
restriction metadata_issuer_validated:
  "All a i #t. MetaIssuer(a, i) @ #t ==> a = i"
#endif

// A (possibly malicious) MCP server names AS $AS2 in its metadata; the client
// fetches $AS2's metadata (claimed issuer $I) and decides whether to send the
// credential it stored under $A.
rule Client_Token_Request:
    [ !ClientCred($C, $A, cred)
    , In(<'prm', $RS, $AS2>)
    , !ASMeta($AS2, $I)
    ]
  --[ MetaIssuer($AS2, $I), CredLookup($A, $I), CredentialSent($C, $AS2, cred) ]->
    [ ToAS($AS2, <'token_request', $C, cred>) ]

// An honest AS accepts a request carrying a credential it issued.
rule AS_Accepts:
    [ ToAS($A, <'token_request', $C, cred>)
    , !HonestAS($A)
    , !ClientCred($C, $A, cred)
    ]
  --[ TokenIssued($C, $A) ]->
    [ ]

// A dishonest AS hands whatever it receives to the attacker.
rule Dishonest_AS_Leaks:
    [ ToAS($X, m), !DishonestAS($X) ]
  --[ Leaked($X) ]->
    [ Out(m) ]

// Sanity check: an honest run can complete.
lemma executable:
  exists-trace
  "Ex C A #i. TokenIssued(C, A) @ #i
     & not (Ex X #k. AS_Dishonest(X) @ #k)"

// P1: a credential registered at an honest AS never reaches the attacker.
lemma client_credential_secrecy:
  "All C A cred #i.
     Registered(C, A, cred) @ #i
     ==> not (Ex #j. K(cred) @ #j)"

end
